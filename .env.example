# Копировать в packages/api/.env для локальной разработки без Docker.
# В контейнере и на Fly эти значения задаёт окружение образа, .env там не нужен.

# SQLite-файл. Относительный путь разрешается от packages/api.
DATABASE_URL=file:../../var/card.db

PORT=4000
HOST=127.0.0.1
GRAPHIQL=true
CARD_APP_VERSION=1.0.0

# Каталог со статикой Next-экспорта. Пусто или нет каталога — работает только API.
STATIC_DIR=../web/out

# Номер телефона на визитку не кладём (решение владельца). Если очень нужно,
# строка попадёт в базу с visibility=private и публичный API её не отдаст.
# CARD_PHONE_URL=tel:+70000000000

# Для веба: адрес GraphQL, если он поднят отдельно от статики.
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://127.0.0.1:4000/graphql
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/Ricorder/
